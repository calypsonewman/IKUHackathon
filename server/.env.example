# Copy to server/.env (git-ignored)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Used if GEMINI_MODEL is overloaded (503) or rate-limited (429)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# auto = Google Search grounding, falling back to Google News RSS + Gemini summary
# rss  = always use Google News RSS (works on the free tier)
NEWS_MODE=auto
# NHS Directory of Healthcare Services API key (integration test environment, from digital.nhs.uk/developer)
NHS_API_KEY=
# Google Places API (New) key: star ratings for clinics (server-side only)
GOOGLE_PLACES_API_KEY=
# Our own cap on Google requests per day (each clinic search uses 2). 30/day stays within the free tier.
GOOGLE_DAILY_LIMIT=30
